{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "additionalProperties": false,
    "$id": "api_file_request",
    "title": "API File Request",
    "description": "REST API File Downloader Config Schema",
    "properties": {
        "AuthenticationHandlerConfig": {
            "oneOf": [
                {
                    "type": "object",
                    "additionalProperties": false,
                    "$id": "#BasicAuthenticator",
                    "properties": {
                        "Type": {
                            "type": "string",
                            "const": "Integrations.Interface.RestAPI.AuthenticationHandlers.BasicAuthenticator"
                        },
                        "Parameters": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "username": {
                                    "type": "string"
                                },
                                "password": {
                                    "type": "string"
                                }
                            },
                            "required": [
                                "username",
                                "password"
                            ]
                        }
                    },
                    "required": [
                        "Type",
                        "Parameters"
                    ]
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "$id": "#OAUTH2ClientCredentialsAuthenticator",
                    "properties": {
                        "Type": {
                            "type": "string",
                            "const": "Integrations.Interface.RestAPI.AuthenticationHandlers.OAUTH2ClientCredentialsAuthenticator"
                        },
                        "TokenUri": {
                            "type": "string"
                        },
                        "TokenRequestTimeout": {
                            "type": "integer"
                        },
                        "TokenRequestParameters": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "grant_type": {
                                    "type": "string"
                                },
                                "Client_ID": {
                                    "type": "string"
                                },
                                "Client_Secret": {
                                    "type": "string"
                                },
                                "scope": {
                                    "type": "string"
                                }
                            },
                            "required": [
                                "grant_type",
                                "Client_ID",
                                "Client_Secret"
                            ]
                        }
                    },
                    "required": [
                        "Type",
                        "TokenUri",
                        "TokenRequestTimeout",
                        "TokenRequestParameters"
                    ]
                }
            ]
        },
        "DataRootPath": {
            "type": "string"
        },
        "FileHandlerConfig": {
            "oneOf": [
                {
                    "type": "object",
                    "additionalProperties": false,
                    "$id": "#DirectUrlFileHandler",
                    "properties": {
                        "FileDownloadMaxDegreeOfParallelism": {
                            "type": "integer"
                        },
                        "FileNameColumnName": {
                            "type": "string"
                        },
                        "FilesToDownloadViewName": {
                            "type": "string"
                        },
                        "FilterOnBatchRef": {
                            "type": "boolean"
                        },
                        "FilterOnGroupRef": {
                            "type": "boolean"
                        },
                        "FileDownloadURLColumnName": {
                            "type": "string"
                        },
                        "FilesToDownloadViewColumnNames": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "ToDownloadViewFilestoreTableColumnMapping": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        },
                        "Type": {
                            "type": "string",
                            "const": "Integrations.Interface.RestAPI.FileHandlers.DirectUrlFileHandler"
                        }
                    },
                    "required": [
                        "Type"
                    ]
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "$id": "#DelegatedUrlFileHandler",
                    "properties": {
                        "FileDownloadMaxDegreeOfParallelism": {
                            "type": "integer"
                        },
                        "FileNameColumnName": {
                            "type": "string"
                        },
                        "FilesToDownloadViewName": {
                            "type": "string"
                        },
                        "FilterOnBatchRef": {
                            "type": "boolean"
                        },
                        "FilterOnGroupRef": {
                            "type": "boolean"
                        },
                        "LargeFileHandling": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "FileSizeColumnName": {
                                    "type": "string"
                                },
                                "LargeFileSizeThresholdBytes": {
                                    "type": "integer"
                                },
                                "TempFileFolderName": {
                                    "type": "string"
                                }
                            },
                            "required": [
                                "FileSizeColumnName",
                                "LargeFileSizeThresholdBytes",
                                "TempFileFolderName"
                            ]
                        },
                        "FilesToDownloadViewColumnNames": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "RequestBodyTemplate": {
                            "type": "object"
                        },
                        "ToDownloadViewFilestoreTableColumnMapping": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        },
                        "Type": {
                            "type": "string",
                            "const": "Integrations.Interface.RestAPI.FileHandlers.DelegatedUrlFileHandler"
                        }
                    },
                    "required": [
                        "RequestBodyTemplate",
                        "Type"
                    ]
                }
            ]
        },
        "MAX_QUERY_RETRIES": {
            "type": "integer"
        },
        "MAX_QUERY_DELAY": {
            "type": "integer"
        },
        "PagingHandlerConfig": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "OldType": {
                    "type": "string"
                },
                "Type": {
                    "type": "string",
                    "const": "NoPaging.DefaultPagingHandler"
                }
            },
            "required": [
                "Type"
            ]
        },
        "QUERY_TIMEOUT": {
            "type": "integer"
        },
        "QueryUri": {
            "type": "string"
        }
    },
    "required": [
        "DataRootPath",
        "QueryUri"
    ]
}